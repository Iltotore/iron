    def moduleDeps = Seq(main, borer)

    def mvnDeps = Seq(
      mvn"io.bullet::borer-core::1.13.0",
      mvn"io.bullet::borer-derivation::1.13.0"
    )

trait SubModule extends BaseModule:

  def moduleDeps = Seq(main)

  trait JSSubModule extends super.JSCrossModule:
    def moduleDeps = Seq(main.js)

  trait NativeSubModule extends super.NativeCrossModule:
    def moduleDeps = Seq(main.native)

