    val http4sVersion = "0.23.16"

    def mvnDeps = Seq(
      //mvn"org.typelevel::cats-core:2.8.0",
      mvn"io.circe::circe-core:$circeVersion",
      mvn"io.circe::circe-parser:$circeVersion",
      mvn"io.circe::circe-generic:$circeVersion",
      mvn"org.http4s::http4s-core:$http4sVersion",
      mvn"org.http4s::http4s-dsl:$http4sVersion",
      mvn"org.http4s::http4s-ember-server:$http4sVersion",
      mvn"org.http4s::http4s-circe:$http4sVersion",
    )

  object formZio extends ScalaModule with ScalafmtModule:

