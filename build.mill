      mvn"dev.zio::zio-http:3.1.0"
    )

  object formJsoniter extends ScalaModule with ScalafmtModule:

    def scalaVersion = versions.scala

    def moduleDeps = Seq(main, jsoniter)

    val jsoniterVersion = "2.19.1"

    def mvnDeps = Seq(
